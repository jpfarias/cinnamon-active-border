{
    "head": {
        "type": "header",
        "description": "Active window border"
    },
    "border-color": {
        "type": "colorchooser",
        "default": "#74c7ec",
        "description": "Border color for the focused window"
    },
    "border-width": {
        "type": "spinbutton",
        "default": 3,
        "min": 1,
        "max": 10,
        "step": 1,
        "units": "px",
        "description": "Border thickness"
    },
    "border-radius": {
        "type": "spinbutton",
        "default": 12,
        "min": 0,
        "max": 30,
        "step": 1,
        "units": "px",
        "description": "Corner rounding"
    },
    "inactive-border": {
        "type": "switch",
        "default": false,
        "description": "Also show a subtle border on unfocused windows"
    },
    "inactive-color": {
        "type": "colorchooser",
        "default": "#313244",
        "description": "Border color for unfocused windows"
    },
    "hide-on-maximized": {
        "type": "switch",
        "default": false,
        "description": "Hide the border on maximized windows"
    }
}
